{
  "name": "my-drim-list-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "setup": "npm run install:all && npm run db:setup && npm run db:restore",
    "dev:backend": "npm --prefix backend run start",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "seed": "npm --prefix backend run seed",
    "db:setup": "npm --prefix backend run db:setup",
    "db:reset": "npm --prefix backend run db:reset",
    "db:seed": "npm --prefix backend run db:seed",
    "db:dump": "npm --prefix backend run db:dump",
    "db:restore": "npm --prefix backend run db:restore",
    "db:verify": "npm --prefix backend run db:verify",
    "db:make-admin": "npm --prefix backend run db:make-admin --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
