# Copy to backend/.env and fill in. Never commit the real .env.
#
# PostgreSQL connection string. The database must already exist:  createdb mdl
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mdl

# Secret used to sign JWTs. Any long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Port the API listens on. The frontend's VITE_API_URL must match.
PORT=4000
